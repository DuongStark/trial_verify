# Copy this file to .env and change secrets before running locally.
# Never commit the real .env file.
# These are DEV-ONLY defaults; change them for any real deployment.

NODE_ENV=development

# Service ports (inside Docker network)
ACCOUNT_PORT=3001
RISK_PORT=3002
CASE_PORT=3003

# PostgreSQL
ACCOUNT_DATABASE_URL=postgresql://account_svc:account_pass@postgres:5432/account_trial_db
CASE_DATABASE_URL=postgresql://case_svc:case_pass@postgres:5432/fraud_case_db

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_pass

# RabbitMQ (non-guest user so other containers can connect)
RABBITMQ_URL=amqp://app:app_pass@rabbitmq:5672

# Internal service URLs
RISK_SERVICE_URL=http://graph-risk:3002
GRAPH_SERVICE_URL=http://graph-risk:3002

# Secrets (change in local .env for anything beyond demo)
JWT_SECRET=local_dev_jwt_secret_change_me
FP_HMAC_SECRET=local_dev_fp_secret_change_me
INTERNAL_SERVICE_TOKEN=local_dev_internal_token

# Timeouts / retry
RISK_HTTP_TIMEOUT_MS=2000
GRAPH_HTTP_TIMEOUT_MS=3000
SERVICE_MAX_ATTEMPTS=2

# Demo only
OTP_FIXED_CODE=123456
DEMO_AUTO_VERIFY=false
