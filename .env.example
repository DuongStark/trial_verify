# Copy this file to .env and change secrets before running locally.
# Never commit the real .env file.

NODE_ENV=development

# Service ports (inside Docker network)
ACCOUNT_PORT=3001
RISK_PORT=3002
CASE_PORT=3003

# PostgreSQL
ACCOUNT_DATABASE_URL=postgresql://account_svc:change_me@postgres:5432/account_trial_db
CASE_DATABASE_URL=postgresql://case_svc:change_me@postgres:5432/fraud_case_db

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Internal service URLs
RISK_SERVICE_URL=http://graph-risk:3002
GRAPH_SERVICE_URL=http://graph-risk:3002

# Secrets (change in local .env)
JWT_SECRET=change_me
FP_HMAC_SECRET=change_me
INTERNAL_SERVICE_TOKEN=change_me

# Timeouts / retry
RISK_HTTP_TIMEOUT_MS=2000
GRAPH_HTTP_TIMEOUT_MS=3000
SERVICE_MAX_ATTEMPTS=2

# Demo only
OTP_FIXED_CODE=123456
DEMO_AUTO_VERIFY=false
